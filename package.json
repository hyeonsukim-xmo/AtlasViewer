{
  "name": "exmo-segmentation-atlas",
  "version": "0.1.27-runtime-slim.6",
  "private": true,
  "description": "EXMO segmentation atlas desktop and web viewer",
  "license": "MIT",
  "author": "EXMO",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "performance:desktop": "node scripts/performance-desktop.cjs",
    "performance:startup": "node scripts/security/benchmark-startup.cjs",
    "dev": "vite --host 127.0.0.1 --port 3016",
    "build": "vite build",
    "build:viewer": "vite build --mode viewer && node scripts/validate-viewer-build.cjs",
    "test:viewer": "node --test scripts/security/test-viewer.cjs",
    "check": "tsc --noEmit",
    "test:language": "node scripts/validate-language.mjs",
    "test:license": "node --test scripts/security/test-license.cjs scripts/security/test-internal.cjs && node scripts/validate-early-results.cjs && node scripts/validate-analysis-pipeline.cjs",
    "test:model-security": "node --test scripts/security/test-model-package.cjs scripts/security/test-models.cjs scripts/security/test-customer.cjs scripts/security/test-operations.cjs scripts/security/test-payload.cjs",
    "test:artifact-security": "work\\modality-integration\\envs\\ct\\Scripts\\python.exe -B scripts/security/test_artifact_store.py && work\\modality-integration\\envs\\ct\\Scripts\\python.exe -B scripts/security/validate-protected-results.py",
    "test": "node --experimental-strip-types scripts/validate-atlas.mjs && node --experimental-strip-types scripts/validate-interactions.mjs",
    "extract:model": "node scripts/extract-exmo.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3017",
    "build:desktop": "vite build --mode desktop && node --experimental-strip-types scripts/write-imaging-palette.mjs",
    "desktop": "npm run build:desktop && electron .",
    "desktop:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-imaging.ps1",
    "desktop:pack": "node scripts/security/package.cjs customer dir",
    "desktop:dist": "node scripts/security/package.cjs customer nsis",
    "desktop:pack:internal": "node scripts/security/package.cjs internal dir",
    "desktop:dist:internal": "node scripts/security/package.cjs internal nsis",
    "test:desktop": "npm run build:desktop && electron scripts/validate-desktop.cjs",
    "test:classifier": "work\\modality-integration\\envs\\ct\\Scripts\\python.exe -X utf8 scripts/validate-classifier.py",
    "test:imaging": "work\\modality-integration\\envs\\ct\\Scripts\\python.exe -X utf8 scripts/validate-imaging.py",
    "test:transfer": "work\\modality-integration\\envs\\ct\\Scripts\\python.exe -X utf8 scripts/validate-transfer-integrity.py",
    "test:imaging:desktop": "npm run build && npm run build:desktop && electron scripts/validate-imaging-desktop.cjs",
    "test:solutions": "node scripts/validate-solution-contracts.cjs",
    "test:solution-security": "node --test scripts/security/test-solutions.cjs scripts/security/test-license-terms.cjs",
    "test:installations": "node --test scripts/security/test-installations.cjs scripts/security/test-model-expiry.cjs",
    "test:accounts": "node --test scripts/security/test-accounts.cjs",
    "test:publications": "node --test scripts/security/test-publications.cjs",
    "test:remote": "node --experimental-strip-types --test scripts/security/test-remote-results.cjs",
    "test:overlays": "node --test scripts/security/test-overlays.cjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.12",
    "openid-client": "6.8.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "three": "0.185.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "oxfmt": "0.61.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.exmo.atlas",
    "productName": "EXMO Atlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-desktop/**/*",
      "desktop/*.cjs",
      "desktop/diagnostics.json",
      "desktop/security/*.cjs",
      "desktop/icon.*",
      "package.json",
      "LICENSE",
      "!node_modules/**/*",
      {
        "from": "node_modules",
        "to": "node_modules",
        "filter": [
          "openid-client/**/*",
          "oauth4webapi/**/*",
          "jose/**/*"
        ]
      }
    ],
    "extraResources": [
      { "from": "desktop/security/windows-key.ps1", "to": "security/windows-key.ps1" },
      {
        "from": "desktop",
        "to": "imaging",
        "filter": [
          "*.py",
          "!model-runner.py",
          "!model_security.py"
        ]
      },
      {
        "from": "dist-desktop/imaging-palette.json",
        "to": "imaging/imaging-palette.json"
      }
    ],
    "asar": true,
    "beforePack": "scripts/security/package.cjs",
    "npmRebuild": false,
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "artifactName": "EXMO-Atlas-Setup-${version}.${ext}"
    }
  }
}
